# ---------------------------------------------------------------------------
# CBN Staff Multipurpose Cooperative Society Ltd — environment configuration
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Canonical public origin, used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.thecbncoop.com

# Administration console (/admin).
# Set a strong password. If left blank the admin console refuses to open.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie (min 32 random characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: where form notifications are delivered once a provider is approved.
# Leave blank to store submissions on disk under /data/submissions.
CONTACT_NOTIFICATION_EMAIL=
