# ---------------------------------------------------------------------------
# CBN Staff Multipurpose Cooperative Society Ltd — environment configuration
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Canonical public origin, used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.thecbncoop.com

# ---------------------------------------------------------------------------
# Supabase (content management system)
#
# Project Settings > API. The anon key is public; the service role key must
# never be exposed to the browser or committed. Set all three to enable the
# database-backed CMS, staff accounts, media uploads and the enquiry inbox.
# Without them the site serves the verified files in content/ and the console
# falls back to the local staff password below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local fallback for the staff console, used only when Supabase is not set.
# Ignored entirely once Supabase is configured.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# Optional: where form notifications are delivered once a provider is approved.
CONTACT_NOTIFICATION_EMAIL=
