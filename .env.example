# ---------------------------------------------------------------------------
# CBN Staff Multipurpose Cooperative Society Ltd — environment configuration
# Copy to .env.local and fill in. NEVER commit real values.
# ---------------------------------------------------------------------------

# Canonical public origin, used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.thecbncoop.com

# ---------------------------------------------------------------------------
# Supabase (content management system)
#
# Project Settings > API. The anon key is public; the service role key must
# never be exposed to the browser or committed. Set all three to enable the
# database-backed CMS, staff accounts, media uploads and the enquiry inbox.
# Without them the site serves the verified files in content/ and the console
# falls back to the local staff password below.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Local fallback for the staff console, used only when Supabase is not set.
# Ignored entirely once Supabase is configured.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Analytics (Google Analytics 4)
#
# Admin > Data streams > your web stream > Measurement ID, which looks like
# G-XXXXXXXXXX. Leave blank and no analytics script is loaded at all, so local
# and preview builds never report into the Society's property. Changing this
# requires a redeploy: NEXT_PUBLIC_* values are inlined at build time.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Search Console / Bing verification
#
# Search Console > Settings > Ownership verification > HTML tag. Paste only the
# token from the tag's content attribute (not the whole tag). The meta tag is
# emitted only when a value is set. The XML sitemap at /sitemap.xml can be
# submitted directly in Search Console in addition to the pointer in robots.txt.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Website assistant (chatbot)
#
# Any OpenAI-compatible chat-completions endpoint works; the server calls
# {AI_BASE_URL}/chat/completions with this key. Answers are grounded in the FAQ,
# service summaries and contact details already published on the site, and the
# model is instructed to refuse anything outside them. Leave the key blank and
# the widget tells visitors to contact the Secretariat instead.
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Newsletter delivery
#
# Subscribers are collected without these. Sending a broadcast needs a Knock
# workflow with an email step and a connected sender; the workflow receives
# { subject, message } and one run per subscriber. Leave blank and the console
# reports that delivery is not connected.
# ---------------------------------------------------------------------------
KNOCK_API_KEY=
KNOCK_NEWSLETTER_WORKFLOW=newsletter-broadcast

# Workflow that emails the automatic acknowledgement for a new enquiry. The
# workflow receives { name, reference, department } and one run per enquirer.
KNOCK_ENQUIRY_WORKFLOW=enquiry-acknowledgement

# Optional: where form notifications are delivered once a provider is approved.
CONTACT_NOTIFICATION_EMAIL=
